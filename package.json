{
  "name": "freedompaws-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sync-pwa-version.mjs && node scripts/generate-brand-assets.mjs && node scripts/fetch-imgly-bg-assets.mjs && node scripts/generate-maskable-icon.mjs && next build --webpack",
    "start": "next start",
    "start:mobile": "npm run build && npm run stop:mobile && next start -H 0.0.0.0 -p 3000",
    "stop:mobile": "lsof -ti:3000 | xargs kill 2>/dev/null || true",
    "symptom:merge": "node scripts/merge-approved-symptoms.mjs",
    "symptom:test": "npx tsx scripts/test-symptom-lexicon.ts",
    "symptom:test:all": "npx tsx scripts/test-lexicon-categories.ts",
    "id:migrations:merge": "node scripts/merge-id-migrations.mjs",
    "id:setup": "node scripts/id-supabase-setup.mjs",
    "id:setup:check": "node scripts/id-supabase-setup.mjs --check",
    "id:setup:migrate": "node scripts/id-supabase-setup.mjs --migrations-only",
    "partner:migrate": "node scripts/run-partner-migrations.mjs",
    "pilot:migrate": "node scripts/run-migration-013.mjs",
    "partner:bootstrap": "node scripts/partner-bootstrap.mjs",
    "marketing:crm-export": "node scripts/marketing/export-crm-sheet.mjs",
    "marketing:tn-outreach": "node scripts/marketing/generate-tn-pilot-outreach.mjs",
    "ops:migrate": "node scripts/run-ops-migrations.mjs",
    "ops:verify": "node scripts/ops-launch-verify.mjs",
    "id:backfill-intake-mirror": "npx tsx scripts/backfill-intake-mirror.ts",
    "id:test:intake-fusion": "npx tsx scripts/test-intake-fusion.ts",
    "vercel:env:push": "node scripts/vercel-env-push.mjs",
    "vit-pro:benchmark": "npx tsx scripts/vit-pro-run-benchmark.ts",
    "binders:pdf": "node scripts/binders/generate-all-binder-pdfs.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "fabric": "^7.4.0",
    "heic2any": "^0.0.4",
    "next": "16.2.6",
    "onnxruntime-web": "^1.21.0",
    "openai": "^6.38.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "replicate": "^1.4.0",
    "resend": "^6.12.4",
    "ripple-address-codec": "^5.0.1",
    "stripe": "^18.0.0",
    "xumm": "^1.0.0",
    "xumm-sdk": "^1.11.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postgres": "^3.4.9",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
